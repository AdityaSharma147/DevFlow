# Copy this file to `.env` and replace the placeholders with your real values.

# PostgreSQL connection string. Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Secret used to sign JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-random-secret-here"

# Groq API key for AI task generation. Get one at https://console.groq.com
GROQ_API_KEY="your-groq-api-key-here"